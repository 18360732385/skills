{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/superpowers-commit-gate.js\" --codex",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
