{
  "description": "harness-eng Codex hooks (fail-open)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-adapter.js\" commit-gate superpowers-commit-gate.js",
            "commandWindows": "for /f %i in ('git rev-parse --show-toplevel') do @call \"%i\\.codex\\hooks\\codex-hook.cmd\" commit-gate superpowers-commit-gate.js",
            "timeout": 12,
            "statusMessage": "Checking Bash commit gate"
          }
        ]
      },
      {
        "matcher": "mcp__mysql",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-adapter.js\" mcp-guard mcp-mysql-guard.js",
            "commandWindows": "for /f %i in ('git rev-parse --show-toplevel') do @call \"%i\\.codex\\hooks\\codex-hook.cmd\" mcp-guard mcp-mysql-guard.js",
            "timeout": 8,
            "statusMessage": "Checking MySQL MCP"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-stop-checklist.js\"",
            "commandWindows": "for /f %i in ('git rev-parse --show-toplevel') do @call \"%i\\.codex\\hooks\\codex-hook.cmd\" --direct codex-stop-checklist.js",
            "timeout": 8,
            "statusMessage": "Delivery soft check"
          }
        ]
      }
    ]
  }
}
