<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>施工指挥台</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+SC:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* ============================================================
       HARNESS 施工指挥台 — 双主题（0.8.2 降噪 + 图纸视觉）
       母题：工程图纸 × 夜班表盘。亮色=草图纸/墨绿油墨；暗色=蓝绿黑/荧光表盘。
       等宽字体只做「仪表读数」；唯一的装饰性元素是横幅里的验收印章 Verdict。
       ============================================================ */

    /* ---- 亮色主题（工程图纸：草图纸 + 墨绿油墨） ---- */
    :root, html[data-theme="light"] {
      --bg: #edf0e9;
      --panel: #f7f9f4;
      --panel2: #eff2ea;
      --border: #c3ccbc;
      --border-glow: rgba(14, 122, 78, 0.18);
      --text: #212a22;
      --muted: #5b6b5c;
      --accent: #0e7a4e;
      --accent-soft: rgba(14, 122, 78, 0.08);
      --accent-glow: rgba(14, 122, 78, 0.22);
      --warn: #a37200;
      --warn-soft: rgba(163, 114, 0, 0.1);
      --danger: #bc3f2b;
      --danger-soft: rgba(188, 63, 43, 0.08);
      --ok: #0e7a4e;
      --info: #2b6fa3;
      --bar-track: #dee3d8;
      --cap: #a37200;
      --radius: 2px;
      --font: "IBM Plex Sans SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
      --display: "IBM Plex Sans SC", "Noto Sans SC", "PingFang SC", sans-serif;
      --mono: "JetBrains Mono", "Fira Code", "Cascadia Code", Consolas, monospace;
      --shadow: 0 1px 2px rgba(33, 42, 34, 0.07);
      --term-bg: rgba(14, 122, 78, 0.06);
      --overlay: rgba(33, 42, 34, 0.45);
      --grid-line: rgba(14, 122, 78, 0.045);
      --scanline: none;
      --neon-text: none;
      --neon-strong: none;
    }

    /* ---- 暗色主题（夜班表盘：蓝绿黑 + 荧光绿），默认 ---- */
    html[data-theme="dark"] {
      --bg: #0e1418;
      --panel: #121a20;
      --panel2: #17222a;
      --border: #25333d;
      --border-glow: rgba(70, 209, 142, 0.2);
      --text: #d6ded8;
      --muted: #8fa096;
      --accent: #46d18e;
      --accent-soft: rgba(70, 209, 142, 0.09);
      --accent-glow: rgba(70, 209, 142, 0.32);
      --warn: #d9a441;
      --warn-soft: rgba(217, 164, 65, 0.1);
      --danger: #e87a6c;
      --danger-soft: rgba(232, 122, 108, 0.1);
      --ok: #46d18e;
      --info: #6cb1dc;
      --bar-track: #1e2a32;
      --cap: #d9a441;
      --shadow: none;
      --term-bg: rgba(70, 209, 142, 0.07);
      --overlay: rgba(6, 10, 12, 0.72);
      --grid-line: rgba(70, 209, 142, 0.03);
      --scanline: none;
      --neon-text: none;
      --neon-strong: none;
    }

    * { box-sizing: border-box; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    body {
      margin: 0;
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
    }

    .wrap {
      max-width: 1080px;
      margin: 0 auto;
      padding: 24px 18px 56px;
      position: relative;
      z-index: 1;
    }

    /* ============================================================
       TOPBAR
       ============================================================ */
    .topbar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 16px;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 16px;
    }
    .topbar-left { min-width: 0; flex: 1; }
    .topbar h1 {
      margin: 0 0 6px;
      font-family: var(--display);
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      color: var(--accent);
    }

    .topbar .sub {
      color: var(--muted);
      font-size: 0.78rem;
      letter-spacing: 0.02em;
    }
    .topbar-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }

    /* ---- 按钮：图签键 ---- */
    .btn {
      appearance: none;
      border: 1px solid var(--border);
      background: var(--panel);
      color: var(--text);
      border-radius: var(--radius);
      padding: 6px 13px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      font-family: var(--font);
      letter-spacing: 0.01em;
      transition: border-color 0.15s ease, color 0.15s ease;
      position: relative;
    }
    .btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .btn:active { transform: scale(0.97); }
    .btn.theme { min-width: 80px; }

    /* ============================================================
       角标 mixin —— L 形制图角标，只用于 deck 与首屏横幅
       ============================================================ */
    .deck, .banner-card {
      position: relative;
    }
    .deck::before, .banner-card::before {
      content: '';
      position: absolute;
      top: -1px; left: -1px;
      width: 12px; height: 12px;
      border-top: 2px solid var(--accent);
      border-left: 2px solid var(--accent);
      pointer-events: none;
      z-index: 2;
    }
    .deck::after, .banner-card::after {
      content: '';
      position: absolute;
      bottom: -1px; right: -1px;
      width: 12px; height: 12px;
      border-bottom: 2px solid var(--accent);
      border-right: 2px solid var(--accent);
      pointer-events: none;
      z-index: 2;
    }

    /* ============================================================
       BANNER CARD（首屏总评横幅：Verdict 徽章 + 总评分 + 结论 + 分项）
       ============================================================ */
    .banner-card {
      display: flex;
      flex-wrap: wrap;
      gap: 16px 26px;
      align-items: center;
      margin-bottom: 14px;
      padding: 16px 20px;
      background:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px),
        var(--panel);
      background-size: 24px 24px, 24px 24px, auto;
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    .banner-score {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 172px;
    }
    .banner-score .lab {
      color: var(--muted);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .banner-score .score-row {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .banner-score .val {
      font-family: var(--mono);
      font-size: 2.6rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      color: var(--accent);
    }
    .banner-score .grade {
      font-size: 0.8rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 2px;
      border: 1px solid var(--border);
      white-space: nowrap;
    }
    .banner-score .grade.ok { color: var(--ok); border-color: var(--accent); background: var(--accent-soft); }
    .banner-score .grade.warn { color: var(--warn); border-color: var(--warn); background: var(--warn-soft); }
    .banner-score .grade.no { color: var(--danger); border-color: var(--danger); background: var(--danger-soft); }
    .banner-score .ref-tip {
      font-size: 0.68rem;
      color: var(--muted);
      border: 1px dashed var(--border);
      padding: 2px 8px;
      border-radius: 2px;
      white-space: nowrap;
      cursor: help;
      align-self: flex-start;
    }
    .banner-side { flex: 1 1 280px; min-width: 0; padding-left: 26px; border-left: 1px dashed var(--border); }
    @media (max-width: 720px) {
      .banner-side { padding-left: 0; border-left: none; }
    }
    .banner-side .one-line {
      margin: 0 0 8px;
      font-size: 0.95rem;
      font-weight: 600;
      line-height: 1.6;
    }
    .banner-side .parts {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .banner-side .part {
      font-size: 0.7rem;
      color: var(--muted);
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 3px 8px;
      font-family: var(--mono);
      white-space: nowrap;
    }
    .banner-side .part b { color: var(--text); font-weight: 700; }

    /* ---- 施工阶梯 + 开干清单 同组（决策台内，宽屏双列并排） ---- */
    .pipe-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 0;
      margin-bottom: 14px;
      padding: 14px 18px;
      background: var(--panel2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    .pipe-group .pipe-axis { display: block; min-width: 0; }
    .pipe-group .pipe-axis + .pipe-axis {
      padding-left: 22px;
      border-left: 1px dashed var(--border);
    }
    @media (max-width: 860px) {
      .pipe-group { grid-template-columns: 1fr; }
      .pipe-group .pipe-axis + .pipe-axis {
        padding-left: 0;
        border-left: none;
        padding-top: 14px;
        border-top: 1px dashed var(--border);
      }
    }
    .pipe-group .axis-label {
      font-size: 0.7rem;
      letter-spacing: 0.04em;
      color: var(--muted);
      font-family: var(--mono);
      margin-bottom: 4px;
    }

    .host-capsule {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.72rem;
      font-family: var(--mono);
      cursor: pointer;
      background: transparent;
      color: var(--text);
    }
    .host-capsule:hover { border-color: var(--accent); color: var(--accent); }
    .host-capsule .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--muted);
    }
    .host-capsule.live .dot { background: var(--ok, #2ecc71); }
    .host-capsule.disk_only .dot { background: var(--accent); }
    .host-capsule.unproven .dot { background: var(--warn); }
    .host-capsule.absent .dot { background: var(--muted); }
    .host-capsule.disk_only {
      border-color: var(--accent);
      color: var(--accent);
    }

    .host-matrix {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
    }
    .host-matrix th, .host-matrix td {
      border: 1px solid var(--border);
      padding: 6px 8px;
      text-align: center;
    }
    .host-matrix th { background: var(--panel); font-weight: 700; }
    .host-matrix td.host-id { text-align: left; font-family: var(--mono); }
    .host-matrix .cell-disk { color: var(--muted); }
    .host-matrix .cell-disk.present { color: var(--accent); font-weight: 600; }
    .host-matrix .cell-live.pass { color: var(--ok, #2ecc71); font-weight: 700; }
    .host-matrix .cell-live.fail { color: var(--danger, #e74c3c); font-weight: 700; }
    .host-matrix .cell-live.unproven { color: var(--warn); }
    .host-matrix tr.current td { outline: 1px solid var(--accent); }
    .host-matrix tr.dim td { opacity: 0.55; }
    .host-matrix .status-zh { font-size: 0.78rem; white-space: nowrap; }
    .host-legend {
      margin: 10px 0 0;
      font-size: 0.75rem;
      color: var(--muted);
    }
    .host-pending-hint {
      margin: 8px 0 0;
      font-size: 0.78rem;
      color: var(--warn);
    }
    .gap-expand {
      margin-top: 6px;
      font-size: 0.78rem;
    }
    .gap-expand summary {
      cursor: pointer;
      color: var(--accent);
      list-style: none;
    }
    .gap-expand summary::-webkit-details-marker { display: none; }
    .gap-expand ul {
      margin: 6px 0 0;
      padding-left: 1.1em;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 0.72rem;
      word-break: break-all;
    }
    .trend-banner {
      margin: 0 0 10px;
      padding: 8px 10px;
      border: 1px dashed var(--warn);
      border-radius: var(--radius);
      font-size: 0.78rem;
      color: var(--warn);
      background: var(--warn-soft);
    }
    .diagnose-story {
      margin: 0 0 12px;
      padding: 0;
      list-style: none;
    }
    .diagnose-story li {
      margin: 0 0 6px;
      padding: 6px 10px;
      border-left: 3px solid var(--border);
      font-size: 0.85rem;
    }
    .diagnose-story li.warn { border-left-color: var(--warn); }
    .diagnose-story li.ok { border-left-color: var(--ok, #2ecc71); }

    .pipe .lab {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      font-size: 0.8rem;
      margin-bottom: 8px;
      letter-spacing: 0.01em;
    }
    .pipe .lab span:first-child {
      color: var(--text);
      font-weight: 600;
    }
    .pipe .lab span:last-child {
      color: var(--accent);
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    .pipe-track {
      height: 10px;
      background: var(--bar-track);
      border-radius: 2px;
      overflow: hidden;
      margin-bottom: 10px;
      position: relative;
      border: 1px solid var(--border);
    }
    .pipe-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--info));
      border-radius: 2px;
      position: relative;
      transition: width 0.6s ease;
    }

    .pipe-steps {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .pipe-step {
      position: relative;
      font-size: 0.7rem;
      padding: 3px 9px;
      border-radius: 2px;
      border: 1px solid var(--border);
      color: var(--muted);
      background: var(--panel);
      font-family: var(--mono);
      letter-spacing: 0.01em;
    }
    .pipe-step[data-tip] { cursor: help; }
    .pipe-step[data-tip]:hover::after,
    .pipe-step[data-tip]:focus-visible::after {
      content: attr(data-tip);
      position: absolute;
      left: 0;
      bottom: calc(100% + 8px);
      z-index: 40;
      min-width: 160px;
      max-width: 280px;
      padding: 8px 10px;
      border-radius: 3px;
      border: 1px solid var(--border);
      background: var(--panel);
      color: var(--text);
      font-family: var(--font);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0;
      line-height: 1.45;
      white-space: normal;
      box-shadow: var(--shadow);
      pointer-events: none;
    }
    .pipe-step.done {
      color: var(--ok);
      background: var(--accent-soft);
      border-color: var(--accent);
    }
    .pipe-step.done::before { content: '\2713 '; }
    .pipe-step.current {
      color: var(--warn);
      background: var(--warn-soft);
      border-color: var(--warn);
      font-weight: 700;
    }
    .pipe-step.current::before { content: '\25B8 '; }

    /* ============================================================
       DECK + TABS
       ============================================================ */
    .deck {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      border-bottom: 1px solid var(--border);
      background: var(--panel2);
      align-items: center;
    }
    .tab {
      appearance: none;
      border: 0;
      background: transparent;
      color: var(--muted);
      padding: 11px 18px;
      font-size: 0.84rem;
      font-weight: 600;
      cursor: pointer;
      font-family: var(--font);
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      letter-spacing: 0.01em;
      transition: color 0.15s ease, background 0.15s ease;
      position: relative;
    }
    .tab:hover {
      color: var(--text);
      background: var(--accent-soft);
    }
    .tab.active {
      color: var(--accent);
      border-bottom-color: var(--accent);
      background: var(--panel);
      font-weight: 700;
    }
    .tab-nav {
      margin-left: auto;
      display: flex;
      gap: 6px;
      padding: 0 10px;
    }
    .tab-nav .btn { padding: 5px 10px; }

    .panel { display: none; padding: 18px 20px 20px; min-height: 320px; }
    .panel.active {
      display: block;
      animation: panel-in 0.18s ease-out;
    }
    @keyframes panel-in {
      from { opacity: 0; transform: translateY(3px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .panel > h2 {
      margin: 0 0 4px;
      font-family: var(--display);
      font-size: 1.02rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: 0.01em;
    }
    .panel > .lead {
      margin: 0 0 16px;
      color: var(--muted);
      font-size: 0.84rem;
    }

    /* ============================================================
       VERDICT（验收印章 —— 横幅内唯一装饰性元素）
       双环边框 + 微旋转，像盖在验收单上的章。
       ============================================================ */
    .verdict-badge {
      font-family: var(--font);
      font-size: 0.86rem;
      font-weight: 700;
      padding: 7px 13px;
      border: 2px solid currentColor;
      border-radius: 3px;
      white-space: nowrap;
      letter-spacing: 0.14em;
      text-indent: 0.14em;
      display: inline-block;
      position: relative;
      transform: rotate(-2deg);
      box-shadow:
        inset 0 0 0 3px var(--panel),
        inset 0 0 0 4px currentColor;
      animation: stamp-in 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3) 0.15s both;
    }
    .verdict-badge::after {
      content: '';
      position: absolute;
      inset: -3px;
      border: 2px solid currentColor;
      border-radius: 5px;
      opacity: 0;
      pointer-events: none;
      animation: stamp-ring 0.8s ease-out 0.6s;
    }
    @keyframes stamp-in {
      0% { opacity: 0; transform: rotate(-2deg) scale(1.7); }
      55% { opacity: 1; transform: rotate(-2deg) scale(0.95); }
      100% { opacity: 1; transform: rotate(-2deg) scale(1); }
    }
    @keyframes stamp-ring {
      0% { opacity: 0.45; transform: scale(0.96); }
      100% { opacity: 0; transform: scale(1.3); }
    }
    .verdict-badge.ok {
      color: var(--ok);
      background: transparent;
    }
    .verdict-badge.ok::before { content: '\2713 '; }
    .verdict-badge.no {
      color: var(--danger);
      background: transparent;
    }
    .verdict-badge.no::before { content: '\2717 '; }
    .gap-line {
      margin-top: 10px;
      padding: 10px 12px;
      background: var(--panel2);
      border-radius: 2px;
      font-size: 0.86rem;
      border-left: 3px solid var(--accent);
    }
    .gap-line strong { font-weight: 700; color: var(--accent); }
    .gap-line:empty { display: none; }

    /* ============================================================
       明细折叠（details）
       ============================================================ */
    .fold {
      margin-top: 10px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--panel2);
      padding: 0;
    }
    .fold > summary {
      cursor: pointer;
      padding: 8px 12px;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text);
      list-style: none;
      user-select: none;
    }
    .fold > summary::-webkit-details-marker { display: none; }
    .fold > summary::before { content: '\25B8 '; color: var(--accent); }
    .fold[open] > summary::before { content: '\25BE '; }
    .fold > .fold-body { padding: 4px 12px 12px; }
    .fold.hidden { display: none; }

    /* ============================================================
       COVERAGE + MORPH STRIP（同一行）
       ============================================================ */
    .diag-strips {
      display: flex;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 10px;
      margin-bottom: 14px;
    }
    .diag-strips .coverage-strip,
    .diag-strips .morph-strip {
      flex: 1 1 0;
      margin-bottom: 0;
      min-width: 0;
    }
    @media (max-width: 720px) {
      .diag-strips { flex-wrap: wrap; }
      .diag-strips .coverage-strip,
      .diag-strips .morph-strip { flex: 1 1 100%; }
    }
    .morph-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 16px;
      margin-bottom: 14px;
      padding: 10px 14px;
      background: var(--panel2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-size: 0.8rem;
      border-left: 3px solid var(--info);
    }
    .morph-strip .item { min-width: 0; }
    .morph-strip .k {
      color: var(--muted);
      font-size: 0.7rem;
      letter-spacing: 0.02em;
    }
    .morph-strip .v {
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      margin-right: 4px;
      color: var(--accent);
    }
    .morph-strip .s { color: var(--muted); font-size: 0.72rem; }
    .coverage-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 16px;
      margin-bottom: 14px;
      padding: 10px 14px;
      background: var(--panel2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-size: 0.8rem;
      border-left: 3px solid var(--ok, #3dd68c);
    }
    .coverage-strip .item { min-width: 0; }
    .coverage-strip .k {
      color: var(--muted);
      font-size: 0.7rem;
      letter-spacing: 0.02em;
    }
    .coverage-strip .v {
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      margin-right: 4px;
      color: var(--accent);
    }
    .coverage-strip .s { color: var(--muted); font-size: 0.72rem; }

    /* ============================================================
       DOMAIN SUMMARY（两域一行；不达标域名红字）
       ============================================================ */
    .domain-summary {
      margin-top: 12px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 16px;
      font-size: 0.82rem;
      color: var(--muted);
      line-height: 1.5;
    }
    @media (max-width: 640px) {
      .domain-summary { grid-template-columns: 1fr; }
    }
    .domain-summary .dom-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px 8px;
      padding: 4px 0;
      border-bottom: 1px dashed var(--border);
      min-width: 0;
    }
    .domain-summary .dom-row:nth-last-child(-n+2) { border-bottom: none; }
    @media (max-width: 640px) {
      .domain-summary .dom-row:nth-last-child(-n+2) { border-bottom: 1px dashed var(--border); }
      .domain-summary .dom-row:last-child { border-bottom: none; }
    }
    .domain-summary .dom-name {
      color: var(--accent);
      font-weight: 700;
      min-width: 4.5em;
    }
    .domain-summary .dom-name.warn {
      color: var(--danger);
    }
    .domain-summary .dom-bits { color: var(--muted); }

    /* ============================================================
       ACTIONS
       ============================================================ */
    .actions { list-style: none; margin: 14px 0 0; padding: 0; counter-reset: act; }
    .actions li {
      padding: 12px 0;
      border-top: 1px solid var(--border);
      position: relative;
      padding-left: 28px;
    }
    .actions li::before {
      counter-increment: act;
      content: '0' counter(act);
      position: absolute;
      left: 0;
      top: 12px;
      font-family: var(--mono);
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--accent);
    }
    .actions strong {
      display: block;
      margin-bottom: 4px;
      font-weight: 700;
      color: var(--text);
    }
    .actions span { color: var(--muted); font-size: 0.86rem; }

    /* ---- 命令行代码块 + 复制 ---- */
    .cmd-wrap {
      position: relative;
      margin-top: 8px;
    }
    .cmd {
      display: block;
      font-family: var(--mono);
      font-size: 0.76rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 8px 72px 8px 28px;
      color: var(--accent);
      white-space: pre-wrap;
      word-break: break-all;
      position: relative;
    }
    .cmd::before {
      content: '$';
      position: absolute;
      left: 10px;
      top: 8px;
      color: var(--muted);
      font-weight: 700;
    }
    .cmd-copy {
      position: absolute;
      top: 4px;
      right: 4px;
      z-index: 2;
      padding: 4px 8px !important;
      font-size: 0.65rem !important;
      min-width: 0;
      letter-spacing: 0.02em;
    }
    .cmd-copy.ok {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* ============================================================
       DIAG GRID + CHARTS
       ============================================================ */
    .diag-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 16px;
    }
    @media (max-width: 860px) { .diag-grid { grid-template-columns: 1fr; } }

    .chart-box {
      background: var(--panel2);
      border-radius: var(--radius);
      padding: 14px;
      border: 1px solid var(--border);
    }
    .chart-box h3 {
      margin: 0 0 10px;
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: 0.01em;
    }
    .chart-svg {
      width: 100%;
      height: auto;
      display: block;
    }

    .hbar-row {
      display: grid;
      grid-template-columns: 110px 1fr 36px;
      gap: 8px;
      align-items: center;
      margin: 8px 0;
      font-size: 0.78rem;
    }
    .hbar-track {
      height: 10px;
      background: var(--bar-track);
      border-radius: 2px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .hbar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--warn), var(--danger));
      border-radius: 2px;
      transition: width 0.5s ease;
    }

    /* ============================================================
       STORIES (domain cards)
       ============================================================ */
    .stories {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-top: 12px;
    }
    @media (max-width: 720px) { .stories { grid-template-columns: 1fr; } }
    .story {
      background: var(--panel2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px;
      transition: border-color 0.2s ease;
    }
    .story:hover {
      border-color: var(--accent);
    }
    .story h3 { margin: 0 0 4px; font-size: 0.88rem; font-weight: 700; }
    .story .score {
      font-family: var(--mono);
      font-size: 1.5rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--accent);
    }
    .story .meta { color: var(--muted); font-size: 0.78rem; margin-top: 4px; line-height: 1.5; }

    .status {
      display: inline-block;
      margin-top: 8px;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 10px;
      border-radius: 2px;
      letter-spacing: 0.02em;
      font-family: var(--mono);
    }
    .status.ok {
      background: var(--accent-soft);
      color: var(--ok);
      border: 1px solid var(--accent);
    }
    .status.warn {
      background: var(--warn-soft);
      color: var(--warn);
      border: 1px solid var(--warn);
    }

    /* ============================================================
       TABLE (gaps)
       ============================================================ */
    table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--border); }
    th {
      color: var(--muted);
      font-weight: 600;
      font-size: 0.72rem;
      letter-spacing: 0.03em;
    }
    tbody tr:hover { background: var(--accent-soft); }
    tbody tr:hover td { color: var(--text); }

    /* ============================================================
       TASKS
       ============================================================ */
    .task-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 10px;
    }
    .task {
      background: var(--panel2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px;
      transition: border-color 0.2s ease;
      position: relative;
    }
    .task:hover {
      border-color: var(--info);
    }
    .task h3 { margin: 0 0 4px; font-size: 0.88rem; font-weight: 700; }
    .task .meta { color: var(--muted); font-size: 0.76rem; margin-bottom: 8px; }
    .task .kind-badge {
      display: inline-block;
      font-family: var(--mono);
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      padding: 2px 6px;
      margin-bottom: 8px;
      border-radius: 2px;
      border: 1px solid var(--info);
      color: var(--info);
      background: rgba(14, 165, 233, 0.08);
    }
    .task.residual {
      border-style: dashed;
      border-width: 1px;
      border-color: var(--warn);
      background:
        repeating-linear-gradient(
          -45deg,
          var(--warn-soft),
          var(--warn-soft) 6px,
          transparent 6px,
          transparent 12px
        ),
        var(--panel2);
    }
    .task.residual .kind-badge {
      border-color: var(--warn);
      color: var(--warn);
      background: var(--warn-soft);
    }
    .task.residual:hover {
      border-color: var(--warn);
    }

    /* ============================================================
       TIMELINE + DIFF
       ============================================================ */
    .timeline { list-style: none; margin: 12px 0 0; padding: 0; }
    .timeline li {
      display: flex;
      gap: 12px;
      padding: 8px 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.86rem;
    }
    .timeline li:last-child { border-bottom: 0; }
    .timeline .lab {
      color: var(--accent);
      min-width: 48px;
      font-weight: 700;
      font-family: var(--mono);
      font-size: 0.78rem;
    }

    .diff-chip {
      display: inline-block;
      margin-top: 8px;
      padding: 8px 12px;
      background: var(--accent-soft);
      border: 1px solid var(--accent);
      border-radius: 2px;
      font-size: 0.84rem;
      color: var(--accent);
    }
    .diff-chip::before { content: '\0394 '; font-weight: 700; }

    .empty {
      color: var(--muted);
      font-size: 0.84rem;
      padding: 28px 8px;
      text-align: center;
      font-family: var(--mono);
    }

    /* ============================================================
       TERM（术语悬停提示）
       ============================================================ */
    .term {
      border-bottom: 1px dashed var(--accent);
      background: var(--term-bg);
      border-radius: 2px;
      padding: 0 3px;
      cursor: help;
      position: relative;
      color: var(--accent);
      transition: background 0.15s;
    }
    .term:hover {
      background: var(--accent-soft);
    }
    .term::after {
      content: attr(data-tip);
      position: absolute;
      left: 50%;
      bottom: calc(100% + 8px);
      transform: translateX(-50%);
      width: max-content;
      max-width: 280px;
      padding: 8px 12px;
      border-radius: 2px;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--accent);
      font-size: 0.74rem;
      font-weight: 500;
      line-height: 1.5;
      white-space: normal;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease;
      z-index: 40;
      box-shadow: var(--shadow);
      font-family: var(--mono);
    }
    .term:hover::after, .term:focus::after { opacity: 1; }

    /* ============================================================
       MODALS
       ============================================================ */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: var(--overlay);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      z-index: 50;
      backdrop-filter: blur(2px);
    }
    .modal-backdrop.open { display: flex; animation: fade-in 0.2s ease; }
    @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }

    .modal {
      width: min(640px, 100%);
      max-height: min(80vh, 720px);
      overflow: auto;
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 18px 20px 20px;
      animation: modal-in 0.25s ease-out;
    }
    @keyframes modal-in {
      from { opacity: 0; transform: scale(0.96) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }
    .modal-head h3 {
      margin: 0;
      font-family: var(--display);
      font-size: 1rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: 0.01em;
    }

    .glossary dt {
      font-weight: 700;
      margin-top: 12px;
      color: var(--accent);
    }
    .glossary dd {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 0.86rem;
      padding-left: 16px;
      border-left: 2px solid var(--border);
    }

    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip {
      background: var(--panel2);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 6px 10px;
      font-size: 0.78rem;
      font-family: var(--mono);
      transition: all 0.15s;
    }
    .chip:hover { border-color: var(--accent); }
    .chip strong { color: var(--accent); }
    .chip code { color: var(--warn); }

    .mono { font-family: var(--mono); font-size: 0.8rem; }

    /* ============================================================
       FOOTER
       ============================================================ */
    footer {
      margin-top: 22px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.74rem;
      font-family: var(--mono);
      letter-spacing: 0.02em;
    }

    /* ============================================================
       MISC
       ============================================================ */
    .hidden { display: none !important; }
    /* ---- 光效：仅暗色主题（表盘磷光） ---- */
    html[data-theme="dark"] .banner-score .val {
      text-shadow: 0 0 24px var(--accent-glow);
    }
    html[data-theme="dark"] .pipe-fill {
      box-shadow: 0 0 10px var(--accent-glow);
    }

    .err {
      background: var(--danger-soft);
      border: 1px solid var(--danger);
      color: var(--danger);
      padding: 16px;
      border-radius: var(--radius);
      margin-bottom: 14px;
      font-family: var(--mono);
      font-size: 0.86rem;
    }
    .err::before { content: '[ ERROR ] '; font-weight: 700; }

    /* SVG 内部文字发光（暗色主题增强） */
    html[data-theme="dark"] .chart-svg text {
      filter: drop-shadow(0 0 2px var(--accent-glow));
    }

    /* 滚动条美化 */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--panel2); }
    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 2px;
    }
    ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

    /* 选中文本 */
    ::selection {
      background: var(--accent);
      color: var(--bg);
    }

    /* ---- 减动：关闭 CRT / glitch / 闪烁 / 扫光 ---- */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
      }
      .panel.active { animation: none; }
    }
  </style>
</head>
<body>
  <div class="wrap" id="app">
    <div class="err hidden" id="err"></div>

    <div class="topbar hidden" id="hdr">
      <div class="topbar-left">
        <h1 id="title">Harness 施工指挥台</h1>
        <div class="sub" id="subtitle"></div>
      </div>
      <div class="topbar-actions">
        <button type="button" class="host-capsule absent hidden" id="host-capsule" title="打开落地检查台">
          <span class="dot" aria-hidden="true"></span>
          <span id="host-capsule-text">落地检查</span>
        </button>
        <button type="button" class="btn" id="btn-glossary">名词解释</button>
        <button type="button" class="btn" id="btn-tech">技术细节</button>
        <button type="button" class="btn theme" id="btn-theme" aria-label="切换明暗模式">浅色</button>
      </div>
    </div>

    <section class="banner-card hidden" id="sec-banner">
      <div class="verdict-badge" id="verdict-badge">—</div>
      <div class="banner-score">
        <span class="lab" id="overall-lab">总评分</span>
        <span class="score-row">
          <span class="val" id="overall-val">—</span>
          <span class="grade" id="overall-grade"></span>
        </span>
        <span class="ref-tip" id="overall-ref" title="">仅参考 · ≠开干</span>
      </div>
      <div class="banner-side">
        <p class="one-line" id="headline"></p>
        <div class="parts" id="overall-parts"></div>
      </div>
    </section>

    <div class="deck hidden" id="deck">
      <div class="tabs" role="tablist">
        <button type="button" class="tab active" data-tab="decision" role="tab">决策台</button>
        <button type="button" class="tab" data-tab="diagnose" role="tab">诊断台</button>
        <button type="button" class="tab" data-tab="tasks" role="tab">任务台</button>
        <button type="button" class="tab" data-tab="trend" role="tab">趋势台</button>
        <button type="button" class="tab" data-tab="host" role="tab">落地检查台</button>
        <div class="tab-nav" title="键盘 ← → 或 [ ] 切台 · Esc 关闭弹层">
          <button type="button" class="btn" id="tab-prev" aria-label="上一台">‹</button>
          <button type="button" class="btn" id="tab-next" aria-label="下一台">›</button>
        </div>
      </div>

      <section class="panel active" id="panel-decision" data-panel="decision" role="tabpanel">
        <h2>决策台</h2>
        <p class="lead">还差什么、下一步做什么；施工阶梯与开干清单在此。</p>
        <div class="gap-line" id="gap-line"></div>
        <div class="gap-line" id="upgrade-line"></div>
        <div class="pipe-group">
          <div class="pipe pipe-axis" id="ladder-axis">
            <div class="axis-label">施工阶梯（L0–L5 成熟度）</div>
            <div class="lab">
              <span id="ladder-summary">施工阶梯</span>
              <span id="ladder-pct"></span>
            </div>
            <div class="pipe-track"><div class="pipe-fill" id="ladder-fill" style="width:0%"></div></div>
            <div class="pipe-steps" id="ladder-steps"></div>
          </div>
          <div class="pipe pipe-axis" id="pipe-axis">
            <div class="axis-label">开干清单</div>
            <div class="lab">
              <span id="pipe-summary">开干清单</span>
              <span id="pipe-pct"></span>
            </div>
            <div class="pipe-track"><div class="pipe-fill" id="pipe-fill" style="width:0%"></div></div>
            <div class="pipe-steps" id="pipe-steps"></div>
          </div>
        </div>
        <h3 class="actions-title" id="actions-title" style="margin:16px 0 0;font-size:0.88rem;font-weight:700;color:var(--accent)">下一步建议</h3>
        <ol class="actions" id="actions"></ol>
      </section>

      <section class="panel" id="panel-diagnose" data-panel="diagnose" role="tabpanel">
        <h2>诊断台</h2>
        <p class="lead" id="lagging-lead">哪一域拖后腿、缺口在哪、低分原因。</p>
        <ul class="diagnose-story" id="diagnose-story"></ul>
        <div class="diag-strips" id="diag-strips">
          <div class="coverage-strip hidden" id="coverage-strip"></div>
          <div class="morph-strip hidden" id="morph-strip"></div>
        </div>
        <div class="diag-grid">
          <div class="chart-box">
            <h3>各域文档质量分 vs 上限</h3>
            <div id="chart-domains"></div>
          </div>
          <details class="fold" id="miss-fold" style="margin-top:0">
            <summary>常见缺口分布（明细）</summary>
            <div class="fold-body" id="chart-miss"></div>
          </details>
        </div>
        <div class="domain-summary" id="domain-summary"></div>
        <div class="stories hidden" id="stories"></div>
        <details id="gaps-block" class="fold hidden">
          <summary>低分原因 Top（明细）</summary>
          <div class="fold-body">
            <table>
              <thead><tr><th>域</th><th>路径</th><th>分</th><th>问题</th></tr></thead>
              <tbody id="gaps-body"></tbody>
            </table>
          </div>
        </details>
      </section>

      <section class="panel" id="panel-tasks" data-panel="tasks" role="tabpanel">
        <h2>任务台</h2>
        <p class="lead">下一批可执行的补文档任务（来自 fill-plan / agents 流水线）。</p>
        <div class="task-grid" id="tasks"></div>
        <div class="empty hidden" id="tasks-empty">暂无分片任务。先完成 fill-plan / inventory 后再看本台。</div>
      </section>

      <section class="panel" id="panel-trend" data-panel="trend" role="tabpanel">
        <h2>趋势台</h2>
        <p class="lead" id="trend-lead">历次评分走势 · 与上次对比 · 本轮流水线概况。</p>
        <div class="trend-banner hidden" id="trend-banner"></div>
        <div class="diag-grid" id="trend-grid">
          <div class="chart-box">
            <h3>评分趋势（文档质量分 / 代码覆盖率）</h3>
            <div id="chart-trend"></div>
          </div>
          <div class="chart-box">
            <h3>相对上次 / 本轮 run</h3>
            <div id="diff-block"></div>
            <ul class="timeline" id="run-timeline"></ul>
          </div>
        </div>
        <div class="empty hidden" id="trend-empty">尚无评分历史与对比。可用 fill-score --compare / 多次打分积累。</div>
      </section>

      <section class="panel" id="panel-host" data-panel="host" role="tabpanel">
        <h2>落地检查台</h2>
        <p class="lead" id="host-lead">各 AI 工具的规则 / 钩子 / MCP 是否已落地，以及会话是否已自证（落地≠生效）。</p>
        <div id="host-matrix-wrap"></div>
        <p class="host-pending-hint hidden" id="host-pending"></p>
        <p class="host-legend" id="host-legend"></p>
        <div class="empty hidden" id="host-empty"></div>
      </section>
    </div>

    <div class="modal-backdrop" id="modal-glossary" role="dialog" aria-modal="true" aria-labelledby="glossary-title">
      <div class="modal">
        <div class="modal-head">
          <h3 id="glossary-title">名词解释</h3>
          <button type="button" class="btn" data-close="modal-glossary">关闭</button>
        </div>
        <dl class="glossary" id="glossary"></dl>
      </div>
    </div>

    <div class="modal-backdrop" id="modal-tech" role="dialog" aria-modal="true" aria-labelledby="tech-title">
      <div class="modal">
        <div class="modal-head">
          <h3 id="tech-title">技术细节</h3>
          <button type="button" class="btn" data-close="modal-tech">关闭</button>
        </div>
        <div id="tech-ready" class="chips" style="margin-bottom:12px"></div>
        <div id="tech-miss" style="margin-bottom:12px"></div>
        <div id="tech-run"></div>
        <p class="mono" id="tech-paths" style="color:var(--muted);margin-top:12px"></p>
      </div>
    </div>

    <footer id="footer" class="hidden"></footer>
  </div>
  <script type="application/json" id="report-data">{{REPORT_JSON}}</script>
  <script>
(function () {
  var TAB_ORDER = ["decision", "diagnose", "tasks", "trend", "host"];
  var THEME_KEY = "harness-report-theme";

  function $(id) { return document.getElementById(id); }
  function show(el) { if (el) el.classList.remove("hidden"); }
  function hide(el) { if (el) el.classList.add("hidden"); }
  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }
  function escAttr(s) { return esc(s); }
  function prefersReducedMotion() {
    return !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
  }
  function countUp(el, target, dur) {
    if (!el || typeof target !== "number") return;
    if (prefersReducedMotion()) { el.textContent = target; return; }
    var final = (Math.round(target * 10) / 10).toFixed(1);
    var t0 = performance.now();
    function tick(now) {
      var p = Math.min(1, (now - t0) / dur);
      var eased = 1 - Math.pow(1 - p, 3);
      el.textContent = (Math.round(target * 10 * eased) / 10).toFixed(1);
      if (p < 1) requestAnimationFrame(tick);
    }
    el.textContent = "0.0";
    requestAnimationFrame(tick);
    /* 兜底：后台标签页 rAF 暂停时，setTimeout 仍会触发，保证终值落定 */
    setTimeout(function () { el.textContent = final; }, dur + 60);
  }
  function load() {
    var raw = $("report-data").textContent.trim();
    if (!raw || raw.charAt(0) !== "{") throw new Error("报告数据未注入");
    return JSON.parse(raw);
  }
  function formatChinaTime(iso) {
    if (!iso) return "";
    var d = new Date(iso);
    if (isNaN(d.getTime())) {
      return String(iso).replace("T", " ").replace(/\.\d+Z?$/, "").replace(/Z$/, "");
    }
    var parts = new Intl.DateTimeFormat("en-CA", {
      timeZone: "Asia/Shanghai",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    }).formatToParts(d);
    var map = {};
    parts.forEach(function (p) { map[p.type] = p.value; });
    return map.year + "-" + map.month + "-" + map.day + " " + map.hour + ":" + map.minute + ":" + map.second;
  }
  function buildTermIndex(glossary) {
    var list = [];
    (glossary || []).forEach(function (g) {
      ["en", "id", "zh"].forEach(function (k) {
        var t = g[k];
        if (!t || String(t).length < 2) return;
        list.push({ term: String(t), tip: (g.zh || "") + "：" + (g.tip || ""), en: g.en || g.id || "" });
      });
    });
    list.sort(function (a, b) { return b.term.length - a.term.length; });
    return list;
  }
  function linkTerms(text, termIndex) {
    var raw = String(text == null ? "" : text);
    if (!raw || !termIndex.length) return esc(raw);
    var out = "";
    var i = 0;
    while (i < raw.length) {
      var hit = null;
      for (var t = 0; t < termIndex.length; t++) {
        var item = termIndex[t];
        if (raw.indexOf(item.term, i) === i) {
          hit = item;
          break;
        }
      }
      if (hit) {
        out +=
          '<span class="term" tabindex="0" data-tip="' +
          esc(hit.tip) +
          '">' +
          esc(hit.term) +
          "</span>";
        i += hit.term.length;
      } else {
        out += esc(raw.charAt(i));
        i += 1;
      }
    }
    return out;
  }
  function applyTheme(theme) {
    var next = theme === "dark" ? "dark" : "light";
    document.documentElement.setAttribute("data-theme", next);
    try { localStorage.setItem(THEME_KEY, next); } catch (e) {}
    var btn = $("btn-theme");
    if (btn) btn.textContent = next === "dark" ? "浅色" : "深色";
  }
  function initTheme() {
    var saved = null;
    try { saved = localStorage.getItem(THEME_KEY); } catch (e) {}
    if (saved === "dark" || saved === "light") {
      applyTheme(saved);
      return;
    }
    var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
    applyTheme(prefersDark ? "dark" : "light");
  }
  function setTab(name, skipHash) {
    var id = TAB_ORDER.indexOf(name) >= 0 ? name : "decision";
    document.querySelectorAll(".tab").forEach(function (el) {
      el.classList.toggle("active", el.getAttribute("data-tab") === id);
    });
    document.querySelectorAll(".panel").forEach(function (el) {
      el.classList.toggle("active", el.getAttribute("data-panel") === id);
    });
    if (!skipHash && window.history && window.history.replaceState) {
      try {
        window.history.replaceState(null, "", "#" + id);
      } catch (e) {}
    }
  }
  function tabFromHash() {
    var h = (location.hash || "").replace(/^#/, "");
    if (TAB_ORDER.indexOf(h) >= 0) setTab(h, true);
  }
  function shiftTab(delta) {
    var cur = document.querySelector(".tab.active");
    var name = cur ? cur.getAttribute("data-tab") : "decision";
    var idx = TAB_ORDER.indexOf(name);
    if (idx < 0) idx = 0;
    var next = (idx + delta + TAB_ORDER.length) % TAB_ORDER.length;
    setTab(TAB_ORDER[next]);
  }
  function openModal(id) {
    var el = $(id);
    if (el) el.classList.add("open");
  }
  function closeModal(id) {
    var el = $(id);
    if (el) el.classList.remove("open");
  }
  function closeAnyModal() {
    var open = document.querySelector(".modal-backdrop.open");
    if (open) {
      open.classList.remove("open");
      return true;
    }
    return false;
  }
  function cmdHtml(command) {
    if (!command) return "";
    return (
      '<div class="cmd-wrap">' +
      '<code class="cmd">' + esc(command) + "</code>" +
      '<button type="button" class="btn cmd-copy" data-copy="' + esc(command) + '" title="复制命令">复制</button>' +
      "</div>"
    );
  }
  function copyText(text, btn) {
    function ok() {
      if (!btn) return;
      var prev = btn.textContent;
      btn.textContent = "已复制";
      btn.classList.add("ok");
      setTimeout(function () {
        btn.textContent = prev || "复制";
        btn.classList.remove("ok");
      }, 1400);
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(ok).catch(function () {
        fallbackCopy(text, ok);
      });
    } else {
      fallbackCopy(text, ok);
    }
  }
  function fallbackCopy(text, done) {
    var ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.left = "-9999px";
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand("copy"); } catch (e) {}
    document.body.removeChild(ta);
    if (done) done();
  }
  function isTypingTarget(el) {
    if (!el) return false;
    var tag = (el.tagName || "").toLowerCase();
    return tag === "input" || tag === "textarea" || tag === "select" || el.isContentEditable;
  }
  function domainBars(chart) {
    var labels = (chart && (chart.labels_zh && chart.labels_zh.length ? chart.labels_zh : chart.labels)) || [];
    var quality = (chart && chart.quality) || [];
    var caps = (chart && chart.caps) || [];
    if (!labels.length) return "<p style=\"color:var(--muted);font-size:0.82rem\">暂无分域数据</p>";
    var w = 420, h = 28 + labels.length * 36, padL = 72, padR = 24, max = 100;
    var rows = labels.map(function (lab, i) {
      var y = 20 + i * 36;
      var q = Math.max(0, Math.min(100, quality[i] || 0));
      var c = Math.max(0, Math.min(100, caps[i] || 100));
      var bw = w - padL - padR;
      var qw = (q / max) * bw;
      var cx = padL + (c / max) * bw;
      return (
        '<text x="0" y="' + (y + 12) + '" fill="currentColor" font-size="12" font-family="var(--mono)">' + esc(lab) + "</text>" +
        '<rect x="' + padL + '" y="' + y + '" width="' + bw + '" height="14" rx="2" fill="var(--bar-track)"/>' +
        '<rect x="' + padL + '" y="' + y + '" width="' + qw + '" height="14" rx="2" fill="var(--accent)"/>' +
        '<line x1="' + cx + '" y1="' + (y - 2) + '" x2="' + cx + '" y2="' + (y + 16) + '" stroke="var(--cap)" stroke-width="2"/>' +
        '<text x="' + (padL + qw + 6) + '" y="' + (y + 12) + '" fill="var(--muted)" font-size="11">' + q + "%</text>"
      );
    }).join("");
    return '<svg class="chart-svg" viewBox="0 0 ' + w + ' ' + h + '" role="img" aria-label="各域文档质量分">' + rows + "</svg>";
  }
  function missBars(missTop) {
    if (!missTop || !missTop.length) return "<p style=\"color:var(--muted);font-size:0.82rem\">暂无常见缺口数据</p>";
    var max = Math.max.apply(null, missTop.map(function (m) { return m.count; })) || 1;
    return missTop.map(function (m) {
      var pct = Math.round((m.count / max) * 100);
      return (
        '<div class="hbar-row"><div class="mono" title="' + esc(m.id) + '">' + esc(m.label_zh || m.id) +
        '</div><div class="hbar-track"><div class="hbar-fill" style="width:' + pct + '%"></div></div><div>' +
        esc(m.count) + "</div></div>"
      );
    }).join("");
  }
  function trendLines(trend) {
    if (!trend || !trend.labels || trend.labels.length < 1) {
      return "<p style=\"color:var(--muted);font-size:0.82rem\">尚无评分历史</p>";
    }
    var labels = trend.labels;
    var oLink = trend.overall_linkable || trend.overall || [];
    var cLink = trend.coverage_linkable || trend.coverage || [];
    var oRaw = trend.overall || [];
    var incomp = trend.incomparable || [];
    var w = 440, h = 160, padL = 36, padR = 12, padT = 16, padB = 28;
    var n = labels.length;
    function xAt(i) {
      if (n <= 1) return padL + (w - padL - padR) / 2;
      return padL + (i / (n - 1)) * (w - padL - padR);
    }
    function yAt(v) {
      if (typeof v !== "number") return null;
      var pct = Math.max(0, Math.min(100, v)) / 100;
      return padT + (1 - pct) * (h - padT - padB);
    }
    function pathFor(arr, stroke) {
      var d = [];
      var started = false;
      for (var i = 0; i < arr.length; i++) {
        var y = yAt(arr[i]);
        if (y == null) {
          started = false;
          continue;
        }
        d.push((started ? "L" : "M") + xAt(i) + " " + y);
        started = true;
      }
      if (!d.length) return "";
      return '<path d="' + d.join(" ") + '" fill="none" stroke="' + stroke + '" stroke-width="2"/>';
    }
    var dots = "";
    for (var i = 0; i < labels.length; i++) {
      var yRaw = yAt(oRaw[i]);
      if (yRaw == null) continue;
      var grey = !!incomp[i];
      dots +=
        '<circle cx="' + xAt(i) + '" cy="' + yRaw + '" r="' + (grey ? 4 : 3) +
        '" fill="' + (grey ? "var(--muted)" : "var(--accent)") + '" opacity="' +
        (grey ? "0.55" : "1") + '"/>';
    }
    var ticks = "";
    for (var j = 0; j < labels.length; j++) {
      ticks +=
        '<text x="' + xAt(j) + '" y="' + (h - 8) + '" text-anchor="middle" fill="var(--muted)" font-size="9">' +
        esc(String(labels[j]).slice(0, 8)) + "</text>";
    }
    return (
      '<svg class="chart-svg" viewBox="0 0 ' + w + " " + h + '" role="img" aria-label="评分趋势">' +
      '<line x1="' + padL + '" y1="' + padT + '" x2="' + padL + '" y2="' + (h - padB) + '" stroke="var(--border)"/>' +
      '<line x1="' + padL + '" y1="' + (h - padB) + '" x2="' + (w - padR) + '" y2="' + (h - padB) + '" stroke="var(--border)"/>' +
      pathFor(oLink, "var(--accent)") +
      pathFor(cLink, "var(--warn)") +
      dots +
      ticks +
      '<text x="' + (w - padR) + '" y="12" text-anchor="end" fill="var(--accent)" font-size="10">文档质量分</text>' +
      '<text x="' + (w - padR) + '" y="24" text-anchor="end" fill="var(--warn)" font-size="10">代码覆盖率</text>' +
      "</svg>"
    );
  }

  var SURFACE_ZH = {
    rules: "规则", hooks: "钩子", mcp: "MCP",
    githooks: "Git 钩子", human_gates: "人工闸"
  };

  function hostCell(disk, live) {
    var present = disk === "present";
    var d = present ? "已落地●" : "未落地○";
    var diskCls = present ? "cell-disk present" : "cell-disk";
    var liveLab = "—";
    var liveCls = "";
    if (live === "pass") { liveLab = "已自证✓"; liveCls = "pass"; }
    else if (live === "fail") { liveLab = "自证失败✗"; liveCls = "fail"; }
    else if (live === "unproven") { liveLab = "待自证"; liveCls = "unproven"; }
    else if (live && String(live).indexOf("skipped") === 0) { liveLab = "跳过"; liveCls = "unproven"; }
    return (
      '<span class="' + diskCls + '">' + d + '</span><br>' +
      '<span class="cell-live ' + liveCls + '">' + liveLab + "</span>"
    );
  }

  function renderHostPanel(hs) {
    var wrap = $("host-matrix-wrap");
    var empty = $("host-empty");
    var legend = $("host-legend");
    var pending = $("host-pending");
    if (pending) { pending.textContent = ""; hide(pending); }
    if (!hs || !hs.hosts || !hs.hosts.length) {
      if (wrap) wrap.innerHTML = "";
      if (empty) {
        empty.textContent = (hs && hs.empty_hint) || "尚未落地任何配置资产；落地后仍须会话自证才算生效。";
        show(empty);
      }
      if (legend) legend.textContent = "";
      return;
    }
    hide(empty);
    var surfaces = hs.surfaces || ["rules", "hooks", "mcp", "githooks"];
    var labels = hs.surface_labels || SURFACE_ZH;
    var head =
      "<tr><th>宿主</th>" +
      surfaces.map(function (s) {
        return "<th>" + esc((labels && labels[s]) || SURFACE_ZH[s] || s) + "</th>";
      }).join("") +
      "<th>状态</th></tr>";
    var rows = hs.hosts.map(function (h) {
      var cls = h.current ? " current" : "";
      if (h.in_ai_tools === false) cls += " dim";
      var cells = surfaces.map(function (s) {
        var disk = (h.disk && h.disk[s]) || "absent";
        var live = h.live ? h.live[s] : null;
        return "<td>" + hostCell(disk, live) + "</td>";
      }).join("");
      var name = h.label_zh || h.id;
      var st = h.status_zh || h.status || "—";
      return (
        '<tr class="' + cls.trim() + '"><td class="host-id">' +
        esc(name) + (h.current ? " · 当前" : "") +
        '</td>' + cells + '<td class="status-zh">' + esc(st) + "</td></tr>"
      );
    }).join("");
    wrap.innerHTML = '<table class="host-matrix"><thead>' + head + "</thead><tbody>" + rows + "</tbody></table>";
    if (legend) {
      legend.textContent =
        (hs.legend && hs.legend.disk ? hs.legend.disk + " · " : "") +
        (hs.legend && hs.legend.live ? hs.legend.live : "") +
        (hs.hint_command ? " · 自证命令：" + hs.hint_command : "");
    }
    if (pending && hs.pending_live_hint && hs.status !== "absent") {
      pending.textContent = hs.pending_live_hint;
      show(pending);
    }
    if (hs.empty_hint && hs.status === "absent") {
      empty.textContent = hs.empty_hint;
      show(empty);
    }
  }

  initTheme();
  $("btn-theme").addEventListener("click", function () {
    var cur = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
    applyTheme(cur === "dark" ? "light" : "dark");
  });
  document.querySelectorAll(".tab").forEach(function (btn) {
    btn.addEventListener("click", function () { setTab(btn.getAttribute("data-tab")); });
  });
  $("tab-prev").addEventListener("click", function () { shiftTab(-1); });
  $("tab-next").addEventListener("click", function () { shiftTab(1); });
  window.addEventListener("hashchange", function () { tabFromHash(); });
  tabFromHash();
  $("btn-glossary").addEventListener("click", function () { openModal("modal-glossary"); });
  $("btn-tech").addEventListener("click", function () { openModal("modal-tech"); });
  document.querySelectorAll("[data-close]").forEach(function (btn) {
    btn.addEventListener("click", function () { closeModal(btn.getAttribute("data-close")); });
  });
  document.querySelectorAll(".modal-backdrop").forEach(function (bd) {
    bd.addEventListener("click", function (e) {
      if (e.target === bd) bd.classList.remove("open");
    });
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
      if (closeAnyModal()) {
        e.preventDefault();
        return;
      }
    }
    if (isTypingTarget(e.target)) return;
    if (document.querySelector(".modal-backdrop.open")) return;
    if (e.key === "ArrowLeft" || e.key === "[") {
      e.preventDefault();
      shiftTab(-1);
    } else if (e.key === "ArrowRight" || e.key === "]") {
      e.preventDefault();
      shiftTab(1);
    }
  });
  document.addEventListener("click", function (e) {
    var btn = e.target && e.target.closest ? e.target.closest("[data-copy]") : null;
    if (!btn) return;
    e.preventDefault();
    copyText(btn.getAttribute("data-copy") || "", btn);
  });

  try {
    var data = load();
    var score = data.score || data;
    var ui = data.ui || {};
    var meta = data.meta || {};
    var run = data.run || null;
    var generatedAt = formatChinaTime(data.generated_at || "");
    var repo = meta.repo_name || score.root || "目标仓";
    var repoShort = String(repo).replace(/\\\\/g, "/").split("/").pop();
    var mode = data.mode || meta.last_mode || "";
    var ladderMeta = meta.ladder || (ui.ladder_progress && ui.ladder_progress.current) || (ui.pipeline_progress && ui.pipeline_progress.ladder) || "";
    var skillVer = meta.skill_version || data.skill_version || "";
    var termIndex = buildTermIndex(ui.glossary || []);

    document.title = "施工指挥台 · " + repoShort;
    $("title").textContent = repoShort + " · 施工指挥台";
    var bits = [];
    if (mode) bits.push("模式 " + mode);
    if (ladderMeta) bits.push("阶梯 " + ladderMeta);
    if (generatedAt) bits.push(generatedAt);
    $("subtitle").textContent = bits.join(" · ");
    show($("hdr"));

    var composite = ui.composite_score || {};
    var pipe = ui.pipeline_progress || {};
    var ladderProg = ui.ladder_progress || {};
    $("overall-lab").textContent = composite.label_zh || "总评分";
    if (typeof composite.value === "number") {
      countUp($("overall-val"), composite.value, 600);
    } else {
      $("overall-val").textContent = "—";
    }
    var gradeEl = $("overall-grade");
    gradeEl.textContent = composite.grade_zh || "";
    gradeEl.className = "grade " + (composite.grade_tone || "");
    var refEl = $("overall-ref");
    refEl.textContent = "仅参考 · ≠开干";
    refEl.title = composite.tip || "";
    $("overall-parts").innerHTML = (composite.parts || []).map(function (p) {
      return '<span class="part">' + esc(p.label_zh || p.id) + " <b>" + esc(p.value) + "%</b></span>";
    }).join("");

    $("ladder-summary").textContent = ladderProg.summary || "施工阶梯";
    $("ladder-pct").textContent =
      typeof ladderProg.percent === "number" ? ladderProg.percent + "%" : "";
    var ladderW = typeof ladderProg.percent === "number" ? Math.max(0, Math.min(100, ladderProg.percent)) : 0;
    var ladderSteps = ladderProg.steps || [];
    $("ladder-steps").innerHTML = ladderSteps.map(function (s) {
      var cls = "pipe-step";
      if (s.done) cls += " done";
      if (s.current) cls += " current";
      var tip = s.tip_zh || ((s.name_zh ? s.name_zh + " — " : "") + (s.label_zh || s.id));
      return (
        '<span class="' + cls + '" tabindex="0" data-tip="' + escAttr(tip) +
        '" title="' + escAttr(tip) + '">' +
        esc(s.label_zh || s.id) + "</span>"
      );
    }).join("");

    $("pipe-summary").textContent = pipe.summary || pipe.label_zh || "开干清单";
    $("pipe-pct").textContent =
      typeof pipe.percent === "number" ? pipe.percent + "%" : "";
    var pipeW = typeof pipe.percent === "number" ? Math.max(0, Math.min(100, pipe.percent)) : 0;
    var steps = pipe.steps || [];
    $("pipe-steps").innerHTML = steps.map(function (s) {
      var cls = "pipe-step";
      if (s.done) cls += " done";
      else if (s.id === pipe.current_id) cls += " current";
      return '<span class="' + cls + '">' + esc(s.label_zh || s.id) + "</span>";
    }).join("");
    requestAnimationFrame(function () {
      $("ladder-fill").style.width = ladderW + "%";
      $("pipe-fill").style.width = pipeW + "%";
    });
    show($("sec-banner"));

    var hs = ui.host_surface || null;
    var cap = $("host-capsule");
    if (cap && hs) {
      cap.className = "host-capsule " + (hs.status || "absent");
      $("host-capsule-text").textContent = "落地 · " + (hs.summary_zh || hs.status || "—");
      show(cap);
      cap.onclick = function () { setTab("host"); };
    }

    var go = ui.go_nogo || {};
    var verdict = ui.verdict || {};
    var readyOk = go.ok != null ? !!go.ok : (!!verdict.ai_coding_ready || !!verdict.ready_ok);
    var badge = $("verdict-badge");
    badge.textContent = go.label_zh || verdict.ready_label || (readyOk ? "建议可以开干" : "建议暂缓");
    badge.className = "verdict-badge " + (readyOk ? "ok" : "no");

    $("headline").innerHTML = linkTerms(ui.headline || score.suggest_next || "（无摘要）", termIndex);
    var gap = ui.gap_to_ready || {};
    var gapHtml =
      "<strong>还差什么：</strong>" + linkTerms(gap.summary_zh || gap.summary || "—", termIndex) +
      (gap.at_ceiling ? " · <strong>已达理论上限</strong>" : "");
    var rawBlockers = gap.ai_coding_blockers || go.blockers || [];
    var grouped = gap.blockers_grouped || [];
    if (rawBlockers.length > 3 || (grouped && grouped.length)) {
      var items = rawBlockers.map(function (b) {
        return "<li>" + esc(b) + "</li>";
      }).join("");
      gapHtml +=
        '<details class="gap-expand"><summary>展开机器码详情（' +
        rawBlockers.length + " 项）</summary><ul>" + items + "</ul></details>";
    }
    $("gap-line").innerHTML = gapHtml;
    var up = ui.suggest_upgrade || score.suggest_upgrade;
    if (up && (up.next_ladder || up.reason)) {
      $("upgrade-line").innerHTML =
        "<strong>建议升阶：</strong>" +
        esc(up.next_ladder ? "下一阶 " + up.next_ladder : "—") +
        (up.reason ? " · " + linkTerms(up.reason, termIndex) : "");
    } else {
      $("upgrade-line").textContent = "";
    }

    var actions = ui.next_actions || [];
    var actTitle = $("actions-title");
    if (actions.length) {
      if (actTitle) show(actTitle);
      $("actions").innerHTML = actions.map(function (a, i) {
        return (
          "<li><strong>" + (i + 1) + ". " + linkTerms(a.title, termIndex) + "</strong><span>" +
          linkTerms(a.detail, termIndex) + "</span>" +
          (a.command ? cmdHtml(a.command) : "") +
          "</li>"
        );
      }).join("");
    } else if (actTitle) {
      hide(actTitle);
    }

    var diagStory = (ui.diagnose && ui.diagnose.story) || [];
    if (diagStory.length) {
      $("diagnose-story").innerHTML = diagStory.map(function (s) {
        return '<li class="' + esc(s.tone || "") + '">' + linkTerms(s.text || "", termIndex) + "</li>";
      }).join("");
    }

    if (ui.lagging_domain && ui.lagging_domain.story) {
      $("lagging-lead").innerHTML =
        "拖后腿优先看：" + esc(ui.lagging_domain.name_zh || ui.lagging_domain.id) +
        " — " + linkTerms(ui.lagging_domain.story, termIndex);
    }

    var covStrip = ui.coverage_strip || [];
    if (covStrip.length) {
      $("coverage-strip").innerHTML = covStrip.map(function (m) {
        return (
          '<div class="item"><div class="k">' + esc(m.label_zh || m.id) + "</div>" +
          '<span class="v">' + esc(m.value) + "</span>" +
          '<span class="s">' + linkTerms(m.sub || "", termIndex) + "</span></div>"
        );
      }).join("");
      show($("coverage-strip"));
    }

    var morph = ui.morph_strip || [];
    if (morph.length) {
      $("morph-strip").innerHTML = morph.map(function (m) {
        return (
          '<div class="item"><div class="k">' + esc(m.label_zh || m.id) + "</div>" +
          '<span class="v">' + esc(m.value) + "</span>" +
          '<span class="s">' + linkTerms(m.sub || "", termIndex) + "</span></div>"
        );
      }).join("");
      show($("morph-strip"));
    }

    $("chart-domains").innerHTML = domainBars(ui.chart_domains);
    $("chart-miss").innerHTML = missBars(ui.miss_top);

    var stories = ui.domain_stories || ui.domains || [];
    if (stories.length) {
      $("domain-summary").innerHTML = stories.map(function (d) {
        var bits = [];
        if (typeof d.score === "number") bits.push(d.score + "%");
        if (d.cap != null) bits.push("上限≈" + d.cap);
        if (d.room != null && d.room > 0) bits.push("距上限 " + d.room);
        if (typeof d.coverage_percent === "number") bits.push("覆盖 " + d.coverage_percent + "%");
        if (d.status_label) bits.push(d.status_label);
        var warn = d.tone === "warn";
        var mark = warn ? "⚠ " : "";
        return (
          '<div class="dom-row">' +
          '<span class="dom-name' + (warn ? " warn" : "") + '">' +
          mark + esc(d.name_zh || d.id) + "</span>" +
          '<span class="dom-bits">' + esc(bits.join(" · ")) + "</span></div>"
        );
      }).join("");
    }

    if (ui.show_domain_cards && stories.length) {
      $("stories").innerHTML = stories.map(function (d) {
        var covLine = "";
        if (typeof d.coverage_percent === "number") covLine = "覆盖 " + d.coverage_percent + "%";
        return (
          '<div class="story"><h3>' + esc(d.name_zh || d.id) +
          ' <span class="mono" style="font-weight:500;color:var(--muted)">' + esc(d.id) + "</span></h3>" +
          '<div class="score">' + (typeof d.score === "number" ? d.score + "%" : "—") + "</div>" +
          '<div class="meta">真相 ' + esc(d.truths != null ? d.truths : "—") +
          (d.cap != null ? " · 上限≈" + d.cap : "") +
          (d.room != null ? " · 距上限 " + d.room : "") +
          (covLine ? "<br>" + esc(covLine) : "") +
          (d.story ? "<br>" + esc(d.story) : "") +
          '</div><span class="status ' + esc(d.tone || "warn") + '">' +
          esc(d.status_label || "") + "</span></div>"
        );
      }).join("");
      show($("stories"));
    }

    var gaps = ui.gaps_top || [];
    if (gaps.length) {
      $("gaps-body").innerHTML = gaps.map(function (g) {
        return (
          "<tr><td>" + esc(g.domain_zh || g.domain) +
          '</td><td class="mono">' + esc(g.path) +
          "</td><td>" + esc(g.score) +
          "</td><td>" + esc((g.issues || []).join("；")) + "</td></tr>"
        );
      }).join("");
      show($("gaps-block"));
    }

    var shards = ui.tasks && ui.tasks.length ? ui.tasks.map(function (t) {
      return {
        id: t.id,
        title: t.title,
        package: t.kind || "",
        hint: t.why || "",
        command: t.cmd,
        kind: t.kind === "residual" ? "residual" : (t.kind === "action" ? "fill" : t.kind),
      };
    }) : (ui.shards || []);
    if (shards.length) {
      $("tasks").innerHTML = shards.map(function (s) {
        var isResidual = s.kind === "residual";
        var cls = "task" + (isResidual ? " residual" : "");
        var badge = isResidual
          ? '<span class="kind-badge">验收遗留</span>'
          : '<span class="kind-badge">补文档</span>';
        return (
          '<div class="' + cls + '">' + badge +
          "<h3>" + esc(s.title || s.id) + "</h3>" +
          '<div class="meta">' + esc(s.package) + " · " + esc(s.hint || "") + "</div>" +
          (s.command ? cmdHtml(s.command) : "") +
          "</div>"
        );
      }).join("");
    } else {
      var empty = $("tasks-empty");
      if (empty) empty.textContent = ui.tasks_empty_hint || "暂无分片任务。先完成 fill-plan / inventory 后再看本台。";
      show(empty);
    }

    var trend = ui.trend;
    var hasTrend = trend && trend.labels && trend.labels.length;
    var hasDiff = ui.diff && ui.diff.summary;
    var timeline = ui.run_timeline || [];
    var banner = $("trend-banner");
    if (banner) {
      var inc = (trend && trend.incomparable) ? trend.incomparable.filter(Boolean).length : 0;
      if (inc > 0) {
        banner.textContent = "有 " + inc + " 个历史点尺度不可比（report_schema / morph_scale），已灰显且不连线。";
        show(banner);
      } else {
        hide(banner);
      }
    }
    if (hasTrend || hasDiff || timeline.length) {
      $("trend-lead").textContent =
        (trend && trend.summary) || "历次评分与本轮 run 对照。";
      $("chart-trend").innerHTML = trendLines(trend);
      $("diff-block").innerHTML = hasDiff
        ? '<div class="diff-chip">' + esc(ui.diff.summary) + "</div>"
        : '<p style="color:var(--muted);font-size:0.82rem;margin:0">暂无对比数据（可用 fill-score --compare）</p>';
      if (timeline.length) {
        $("run-timeline").innerHTML = timeline
          .map(function (t) {
            return (
              "<li><span class=\"lab\">" + esc(t.label_zh || t.id) +
              "</span><span>" + esc(t.value) + "</span></li>"
            );
          })
          .join("");
      }
    } else {
      hide($("trend-grid"));
      show($("trend-empty"));
    }

    renderHostPanel(ui.host_surface);

    var gloss = ui.glossary || [];
    $("glossary").innerHTML = gloss.map(function (g) {
      return (
        "<dt>" + esc(g.zh) + ' <span class="mono" style="font-weight:500">(' + esc(g.en) +
        ")</span></dt><dd>" + esc(g.tip) + "</dd>"
      );
    }).join("");

    var aiReady = score.ai_coding_ready || {};
    var readyCompat = score.ready || {};
    $("tech-ready").innerHTML =
      '<span class="chip">ai_coding_ready: <strong>' + (aiReady.ok ? "YES" : "NO") + "</strong></span>" +
      (score.pass != null ? '<span class="chip">pass: <strong>' + (score.pass ? "true" : "false") + "</strong></span>" : "") +
      (aiReady.rule ? '<span class="chip mono">' + esc(aiReady.rule) + "</span>" : "") +
      (readyCompat.ok != null
        ? '<span class="chip mono">ready(deprecated): ' + (readyCompat.ok ? "YES" : "NO") + "</span>"
        : "") +
      (ui.suggest_raw ? '<span class="chip">' + esc(ui.suggest_raw) + "</span>" : "");

    var miss = ui.miss_top || [];
    if (miss.length) {
      $("tech-miss").innerHTML =
        "<strong>miss_histogram</strong><div class=\"chips\" style=\"margin-top:8px\">" +
        miss.map(function (x) {
          return '<span class="chip"><code>' + esc(x.id) + "</code> <strong>" + x.count + "</strong></span>";
        }).join("") + "</div>";
    }

    if (run && typeof run === "object") {
      var runBits = [];
      ["round", "written", "merged", "unchanged", "skips", "note"].forEach(function (k) {
        if (run[k] != null && run[k] !== "") runBits.push("<li><strong>" + esc(k) + "</strong>: " + esc(run[k]) + "</li>");
      });
      if (runBits.length) $("tech-run").innerHTML = "<strong>本轮 run</strong><ul>" + runBits.join("") + "</ul>";
    }

    var pathBits = [];
    if (data.score_path) pathBits.push("score: " + data.score_path);
    if (data.report_dir) pathBits.push("dir: " + data.report_dir);
    $("tech-paths").textContent = pathBits.join(" · ");

    show($("deck"));
    var hashTab = (location.hash || "").replace(/^#/, "");
    if (TAB_ORDER.indexOf(hashTab) >= 0) setTab(hashTab, true);
    else setTab("decision");

    $("footer").textContent =
      (ui.disclaimer || "本报告不是契约真相。") +
      " skill_version " + (skillVer || "—") +
      " · report_schema " + (ui.report_schema || ui.version || "—") +
      "（报告壳 ≠ skill） · 由 harness-eng fill-report-html 生成 · 不含密文。";
    show($("footer"));
  } catch (e) {
    show($("err"));
    $("err").textContent = "无法渲染报告: " + (e && e.message ? e.message : String(e));
  }
})();
  </script>
</body>
</html>
