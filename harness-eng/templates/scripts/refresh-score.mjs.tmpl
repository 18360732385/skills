#!/usr/bin/env node
/**
 * 工程化快照刷新（中性入口；目标仓 scripts/agent-kb/refresh-score.mjs）。
 * 解析工程化 skill 根后委托：node <skill>/scripts/harness.mjs --mode refresh --root <仓根>
 *
 * 环境变量：HARNESS_ENG_ROOT = 工程化 skill 目录（优先）
 * 用法：node scripts/agent-kb/refresh-score.mjs [--root <仓根>] [--dry-run] [--no-write] [--help]
 * 退出码：透传 harness refresh（0 / 2 / 1）。
 */
import fs from "node:fs";
import path from "node:path";
import os from "node:os";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const DEFAULT_ROOT = path.resolve(__dirname, "../..");

function parseArgs(argv) {
  const out = { root: DEFAULT_ROOT, passthrough: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--root" && argv[i + 1]) {
      out.root = path.resolve(argv[++i]);
    } else if (a === "--help" || a === "-h") {
      out.help = true;
    } else {
      out.passthrough.push(a);
    }
  }
  return out;
}

function skillCandidates() {
  const home = os.homedir();
  const fromEnv = process.env.HARNESS_ENG_ROOT
    ? [path.resolve(process.env.HARNESS_ENG_ROOT)]
    : [];
  return [
    ...fromEnv,
    path.join(home, ".cursor", "skills", "harness-eng"),
    path.join(home, ".agents", "skills", "harness-eng"),
    path.join(home, ".claude", "skills", "harness-eng"),
    path.join(home, ".codex", "skills", "harness-eng"),
  ];
}

function resolveHarnessSkill() {
  for (const dir of skillCandidates()) {
    const harness = path.join(dir, "scripts", "harness.mjs");
    if (fs.existsSync(harness)) return { skillRoot: dir, harness };
  }
  return null;
}

const args = parseArgs(process.argv.slice(2));
if (args.help) {
  console.log(`refresh-score — 工程化快照刷新（中性入口）

用法:
  node scripts/agent-kb/refresh-score.mjs [--root <仓根>] [--dry-run] [--no-write]

环境:
  HARNESS_ENG_ROOT  工程化 skill 目录（含 scripts/harness.mjs）

委托:
  node <skill>/scripts/harness.mjs --mode refresh --root <仓根> …
`);
  process.exit(0);
}

const found = resolveHarnessSkill();
if (!found) {
  console.error(
    "refresh-score: 未找到工程化 skill（设 HARNESS_ENG_ROOT，或安装 harness-eng 到用户 skills 目录）"
  );
  process.exit(1);
}

const childArgs = [
  found.harness,
  "--mode",
  "refresh",
  "--root",
  args.root,
  ...args.passthrough,
];
const r = spawnSync(process.execPath, childArgs, {
  encoding: "utf8",
  cwd: args.root,
  stdio: ["inherit", "pipe", "pipe"],
  maxBuffer: 20 * 1024 * 1024,
});
if (r.stdout) process.stdout.write(r.stdout);
if (r.stderr) process.stderr.write(r.stderr);
process.exit(r.status == null ? 1 : r.status);
