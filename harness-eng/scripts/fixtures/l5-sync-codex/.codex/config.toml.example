[mcp_servers.gitlab]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-gitlab"]
env_vars = ["GITLAB_PERSONAL_ACCESS_TOKEN", "GITLAB_API_URL"]
enabled = true
default_tools_approval_mode = "prompt"

[mcp_servers.mysql_test]
command = "uvx"
args = ["mysql-mcp-server"]
env_vars = ["MYSQL_HOST", "MYSQL_PORT", "MYSQL_USER", "MYSQL_PASSWORD", "MYSQL_DB"]
enabled = false
default_tools_approval_mode = "prompt"

[mcp_servers.redis_test]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-redis"]
env_vars = ["REDIS_URL"]
enabled = false
default_tools_approval_mode = "prompt"
