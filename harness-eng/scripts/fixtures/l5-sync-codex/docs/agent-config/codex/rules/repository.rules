# experimental — Codex command policy (not natural-language AGENTS)
# GENERATED seed from harness-eng; edit SSOT docs/agent-config/codex/rules/

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Push updates remotes; confirm before running.",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-push rewrites remotes; refuse by default.",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force-push rewrites remotes; refuse by default.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destructive reset; use recoverable alternatives.",
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Destructive clean; refuse by default.",
)

prefix_rule(
    pattern = ["git", "clean", "-xfd"],
    decision = "forbidden",
    justification = "Destructive clean including ignored files; refuse by default.",
)
