{
  "_comment": "无密示例；真实连接信息由 fill-mcp 经确认写入 servers.json（vendored_shared）或本机 mcp.local.json（example_only）",
  "mcpServers": {
    "mysql-test": {
      "command": "uvx",
      "args": ["mysql-mcp-server"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "readonly",
        "MYSQL_PASSWORD": "<REPLACE_ME>",
        "MYSQL_DB": "example_db"
      }
    }
  }
}
