# feature-eng 进度文件模板
# 复制为 docs/runs/active/<slug>/progress.yaml；变量 {{slug}} {{title}} {{date}} 由 start 替换。
#
# 【人读摘要】
# - 主题：{{title}}
# - 目录：docs/runs/active/{{slug}}/
# - 本文件为过程态 SSOT（机读字段键英文）；close 后整目录迁入 docs/runs/archive/

slug: "{{slug}}"
title: "{{title}}"
created_at: "{{date}}"
updated_at: "{{date}}"

# spike | bounded | full（分诊闸：用户确认后写入）
path: null

# guided | express（start 首问；见 start.md）
run_mode: guided

# strict | inline（调起策略；见 binding.md；可跟 defaults.invoke）
invoke: strict

# auto | confirm（过闸后是否立即调起下一 skill；见 advance.md）
# 推导：express→auto；guided→confirm；可被 defaults.handoff_policy / 首问覆盖
handoff_policy: confirm

# subagent | inline（环间 L2 语义审核；见 gates-review.md）
# 默认 subagent；宿主无 Task 能力则降级 inline（须显式写 gate 备注，见 start.md O5）
review_policy: subagent

# bound | controller_proxy（start 探测绑定 skill 可调起；不可用则强制 controller_proxy + 警告）
# 见 binding.md「chef_mode」；controller_proxy = 显式降级：控制器兼代厨师角色落盘产物
chef_mode: bound

# off | optional | on（close 时 pitfalls lint；缺省跟 defaults.close_pitfalls，再缺省 optional）
# close_pitfalls: optional

# triage | grill | design | domain-bridge | domain | spec | plan | proto-bridge | proto | testdesign
# | pre-impl | implement | gate | verify | close | done
# 旁态（按需，不在主链）：smoke（B 路径冒烟）| diagnose（排障，先复现再改）
stage: triage

# domain 桥结果：skipped | skipped_by_user | entered（见 domain-bridge.md；默认常 skipped）
domain: null

# proto 桥结果：skipped | skipped_by_user | entered（S 路径无此字段含义）
proto: null

artifacts:
  adr: []            # docs/adr/NNNN-*.md 路径列表
  spec: null         # docs/superpowers/specs/...
  plan: null         # docs/superpowers/plans/...
  proto: null        # 原型目录或文件
  context_delta: null # docs/runs/active|archive/<slug>/术语增量.md
  testcases: null    # …/测试用例.md（仅 F）
  test_report: null  # …/测试报告.md（仅 F）
  qa_report: null    # 外部 QA 报告路径（可选）

# 来自 plan 的任务拆分；depends_on 为任务 id 列表
tasks: []
#  - id: T1
#    title: ...
#    depends_on: []
#    status: pending | doing | done

# 各闸通过时间（ISO）；无时间戳 = 未过（通过条件见 gates-common.md）
gates:
  triage: null
  shared_understanding: null   # 用户显式确认可进设计
  design_confirmed: null       # B: 短设计 yes；F: 整体或每段 yes；express: 可与上一闸同一次总 yes
  go: null
  pre_impl: null
  gate: null
  verify: null
  close: null

# implement 可选环境核验：null | skipped | verified（路径/说明可放 回链.md）
env_verified: null

# 环境备注（O4）：运行时与声明目标不一致时必填；结构见下注释
# env_notes:
#   runtime: "OpenJDK 21"          # 实际运行版本/工具链
#   target: "17"                   # 项目声明目标（如 pom java.version）
#   mismatch_reason: "apt 无 openjdk-17，仅有 21"
env_notes: null

# 用户显式接受的残留（verify 有 fail 仍 close 时记录）
accepted_residual: null
